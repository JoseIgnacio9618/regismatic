{
  "buildCommand": "npm run prisma:generate --workspace backend",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?path=$1"
    },
    {
      "source": "/health",
      "destination": "/api/index?path=health"
    },
    {
      "source": "/health/ready",
      "destination": "/api/index?path=health/ready"
    },
    {
      "source": "/status",
      "destination": "/api/index?path=status"
    }
  ]
}
