{
  "buildCommand": "npm run prisma:generate --workspace backend",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/status",
      "destination": "/api/index"
    }
  ]
}
