generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  EMPLOYEE
}

enum WorkEventType {
  CLOCK_IN
  BREAK_START
  BREAK_END
  CLOCK_OUT
  MANUAL_ADJUSTMENT
}

enum EventSource {
  WEB
  MOBILE
  ADMIN
  SYSTEM
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  EDIT_REQUEST_CREATED
  EDIT_REQUEST_APPROVED
  EDIT_REQUEST_REJECTED
  EVENT_MODIFIED
  TEAM_JOIN_REQUEST_CREATED
  TEAM_JOIN_REQUEST_APPROVED
  TEAM_JOIN_REQUEST_REJECTED
  SYSTEM
}

enum PushPlatform {
  WEB
  ANDROID
  IOS
}

enum TeamJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingPlanCode {
  DEMO_10
  PACK_10
  PACK_20
  PACK_50
  PACK_100
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

model User {
  id                  String                 @id @default(cuid())
  email               String                 @unique
  passwordHash        String
  fullName            String
  profilePhotoPath    String?
  role                Role                   @default(EMPLOYEE)
  adminInviteCode     String?                @unique
  managerId           String?
  manager             User?                  @relation("ManagerEmployees", fields: [managerId], references: [id], onDelete: SetNull)
  managedUsers        User[]                 @relation("ManagerEmployees")
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  events              WorkEvent[]
  modifiedEvents      WorkEvent[]            @relation("WorkEventModifier")
  requestedEditEvents WorkEventEditRequest[] @relation("WorkEventEditRequester")
  reviewedEditEvents  WorkEventEditRequest[] @relation("WorkEventEditReviewer")
  notifications       Notification[]
  pushTokens          PushDeviceToken[]
  teamJoinRequests    TeamJoinRequest[]      @relation("TeamJoinRequestEmployee")
  teamJoinReviews     TeamJoinRequest[]      @relation("TeamJoinRequestReviewer")
  incomingJoinRequests TeamJoinRequest[]     @relation("TeamJoinRequestManager")
  billingSubscription BillingSubscription?
  trialIpClaim        AdminTrialIpClaim?

  @@index([managerId])
  @@index([role, managerId])
}

model WorkEvent {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id])
  type               WorkEventType
  source             EventSource            @default(WEB)
  eventAt            DateTime
  note               String?
  latitude           Float?
  longitude          Float?
  ipAddress          String?
  userAgent          String?
  metadata           Json?
  modifiedAt         DateTime?
  modifiedById       String?
  modifiedBy         User?                  @relation("WorkEventModifier", fields: [modifiedById], references: [id])
  modificationReason String?
  createdAt          DateTime               @default(now())
  editRequests       WorkEventEditRequest[]

  @@index([userId, eventAt])
  @@index([eventAt])
  @@index([modifiedById])
}

model WorkEventEditRequest {
  id               String            @id @default(cuid())
  workEventId      String
  workEvent        WorkEvent         @relation(fields: [workEventId], references: [id])
  requestedById    String
  requestedBy      User              @relation("WorkEventEditRequester", fields: [requestedById], references: [id])
  requestedEventAt DateTime
  requestedNote    String?
  reason           String
  status           EditRequestStatus @default(PENDING)
  reviewComment    String?
  reviewedById     String?
  reviewedBy       User?             @relation("WorkEventEditReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([workEventId, status])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

model PushDeviceToken {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String       @unique
  platform   PushPlatform
  isActive   Boolean      @default(true)
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, isActive])
}

model TeamJoinRequest {
  id              String                @id @default(cuid())
  employeeId      String
  employee        User                  @relation("TeamJoinRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  targetManagerId String
  targetManager   User                  @relation("TeamJoinRequestManager", fields: [targetManagerId], references: [id], onDelete: Cascade)
  inviteCodeUsed  String
  status          TeamJoinRequestStatus @default(PENDING)
  message         String?
  reviewComment   String?
  reviewedById    String?
  reviewedBy      User?                 @relation("TeamJoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([employeeId, createdAt])
  @@index([targetManagerId, status, createdAt])
  @@index([status, createdAt])
  @@index([reviewedById])
}

model BillingSubscription {
  id                    String                    @id @default(cuid())
  adminId               String                    @unique
  admin                 User                      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  planCode              BillingPlanCode
  status                BillingSubscriptionStatus
  seatLimit             Int
  isTrial               Boolean                   @default(false)
  trialEndsAt           DateTime?
  stripeCustomerId      String?                   @unique
  stripeSubscriptionId  String?                   @unique
  stripePriceId         String?
  stripeCheckoutSessionId String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([status, currentPeriodEnd])
  @@index([planCode, status])
}

model AdminTrialIpClaim {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  adminId   String   @unique
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
